        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AgentQueryRequest"
      },
      "ArticleCreateRequest": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "default": "RUNBOOK"
          },
          "author": {
            "type": "string",
            "title": "Author",
            "default": ""
          },
          "content": {
            "type": "string",
            "title": "Content",
            "default": ""
