  "components": {
    "schemas": {
      "AgentQueryRequest": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "chat_history": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ChatMessage"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chat History",
            "default": []
